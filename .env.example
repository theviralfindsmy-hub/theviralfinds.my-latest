# TheViralFindsMY - Environment Variables Example
# Copy this file to .env.local for local development or set in Vercel Dashboard

# Pangkalan Data (PostgreSQL via Neon / Supabase)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth Authentication
NEXTAUTH_URL="https://theviralfindsmy.com"
NEXTAUTH_SECRET="generate-a-secure-32-char-random-string"

# AI Multi-Provider Configuration (NVIDIA NIM / OpenRouter / Kilo)
AI_PROVIDER="nvidia" # Options: nvidia | openrouter | kilo
AI_FAILOVER_ENABLED="true"

# 1. NVIDIA NIM (Primary - Meta Llama 3.3 70B & DeepSeek R1)
NVIDIA_NIM_API_KEY="nvapi-your-key-here"
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_MODEL="meta/llama-3.3-70b-instruct"

# 2. OpenRouter (Secondary / Auto-Failover)
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# 3. Kilo Gateway (Tertiary Fallback)
KILO_API_KEY="kilo-your-key-here"
KILO_BASE_URL="https://api.kilo.ai/v1"
KILO_MODEL="kilo-default"

# Vercel Cron Security Secret
CRON_SECRET="generate-a-random-cron-secret-for-vercel"

# Shopee Affiliate Open API (Optional - will fallback to CSV ingestion if empty)
SHOPEE_APP_ID=""
SHOPEE_SECRET=""
